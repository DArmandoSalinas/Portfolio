# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source certificate originals — kept local on purpose.
# Contains identity documents (photo, handwritten signature, folio numbers).
# Only the web-optimised, reviewed images under public/certs/ are committed.
/Certificates
/Certifications

# Raw diploma scans (high-res / unoptimized). The published web JPEG lives
# in public/certs/tec-mecatronica.jpg and is committed on purpose.
/public/education

# Auto-generated by `next dev` on each run
AGENTS.md
CLAUDE.md

# Source portrait — the web-optimised copy lives in public/me/
/DiegoArmando.jpg
/DiegoArmando.PNG
